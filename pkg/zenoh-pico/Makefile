PKG_NAME = zenoh-pico
PKG_URL = https://github.com/eclipse-zenoh/zenoh-pico
# 1.10.2
PKG_VERSION = 6a881c21dad1f778d0529eb9f297bea339016526
PKG_LICENSE = EPL-2.0 OR Apache-2.0

include $(RIOTBASE)/pkg/pkg.mk

# the RIOT platform layer replaces src/system/<platform>, the other platform
# specific sources are compiled out with ZENOH_GENERIC
ZENOH_PICO_SRC = $(shell cd $(PKG_SOURCE_DIR) && \
  find src -name '*.c' ! -path 'src/system/*' -o -path 'src/system/common/*.c' | sort)

# upstream code is not warning free with the flags used by RIOT
CFLAGS += -Wno-unused-parameter
CFLAGS += -Wno-cast-align
CFLAGS += -Wno-unused-but-set-variable

# strnlen() is only declared by newlib for POSIX.1-2008
CFLAGS += -D_POSIX_C_SOURCE=200809L

all: $(PKG_SOURCE_DIR)/include/zenoh-pico/config.h
	$(QQ)"$(MAKE)" -C $(PKG_SOURCE_DIR) -f $(RIOTBASE)/Makefile.base \
	  MODULE=$(PKG_NAME) SRC="$(ZENOH_PICO_SRC)" SRCXX= ASMSRC= ASSMSRC=

# config.h is generated by CMake upstream, with ZENOH_GENERIC it only includes
# zenoh_generic_config.h
$(PKG_SOURCE_DIR)/include/zenoh-pico/config.h: $(PKG_SOURCE_DIR)/include/zenoh-pico/config.h.in
	$(Q)sed '/#cmakedefine ZP_SYSTEM_PLATFORM_HEADER/d' $< > $@
