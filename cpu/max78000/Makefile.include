# The MAX78000 provides 512 KiB of flash and 128 KiB of SRAM
ROM_START_ADDR ?= 0x10000000
RAM_START_ADDR ?= 0x20000000
ROM_LEN ?= 0x80000
RAM_LEN ?= 0x20000

LINKER_SCRIPT ?= cortexm.ld

# The vendor headers include each other by their bare file names
INCLUDES += -isystem$(RIOTCPU)/max78000/include/vendor

include $(RIOTMAKE)/arch/cortexm.inc.mk
